# Copy this file to backend/.env and adjust. Never commit the real .env.

# "development" or "production"
ENVIRONMENT=development

# SQLite is fine locally. In production point this at your real database.
DATABASE_URL=sqlite:///./studysphere.db

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How long a login lasts, in hours (168 = 7 days).
SESSION_TTL_HOURS=168

# Must be true in production (HTTPS only). Leave false for local http.
COOKIE_SECURE=false
